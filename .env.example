# ------------------------------------------------------------------
# Secrets for the X scraper. Copy this file to `.env`.
#
# Accounts themselves are declared in `config.toml`, which references the
# env-var NAMES below. That split is deliberate: config.toml is safe to back
# up and share, .env never is.
# ------------------------------------------------------------------

# --- Per-account secrets ---
# One pair per [[accounts]] entry in config.toml. The names must match the
# `password_env` / `email_password_env` values there.
#
# You can leave these EMPTY. Adding an account from the dashboard opens a real
# browser and you type the password into x.com itself, so it is never stored
# here. These exist only for the command-line `login` path, which can pre-fill
# the form for you.
X_PASSWORD_ACCT_A=
X_EMAIL_PASSWORD_ACCT_A=


# --- Letting other systems in ---
#
# API keys for programs. Comma-separated, so one consumer can be revoked on its
# own by deleting its key. A key may read collected tweets and trigger a fetch
# from X; it may NOT add accounts, sign in, or change the dashboard view.
#
#   curl -H "Authorization: Bearer <key>" https://your-host/api/tweets
#
# Generate one:  python3 -c "import secrets;print('k_'+secrets.token_urlsafe(32))"
API_KEYS=

# Shared secret for each [[webhooks]] block in config.toml, named there by
# `secret_env`. The receiver uses it to verify the signature on every delivery.
# WEBHOOK_SECRET_MAIN=

# Telegram. Easier to set from the dashboard — "What we are watching" ->
# "Telegram & settings" writes both of these for you and can send a test
# message. Make a bot by messaging @BotFather.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Google Sheets delivery ---
#
# Two ways in, chosen per target in the dashboard (Delivery -> New target ->
# Google Sheet). Google's Sheets API needs a credential for EVERY write -- a
# "anyone with the link can edit" sheet is still not writable without one --
# so the choice is really "whose credential".
#
# (a) APPS SCRIPT, the default. A script pasted into the sheet itself, which
#     runs as YOU, so the server holds no Google credential at all. No cloud
#     project, no key file, no sharing step. The dashboard writes the script
#     for you and mints the token; you paste the token here under whatever
#     name the form shows, one variable per deployment:
#
# SHEET_TOKEN_MAIN=
#
#     The token is what makes a request legitimate -- an Apps Script web app
#     has to be deployed as "Anyone" for a server to reach it at all, so this
#     string is the whole of the front door. Treat it like a password: it is
#     never stored in the database, only its NAME is.
#
# (b) SERVICE ACCOUNT, the standard Sheets API path. Worth it if you already
#     have a Google Cloud project, or want one credential to serve many
#     sheets.
#
#   1. Google Cloud console -> a project -> enable the Google Sheets API.
#   2. Create a service account, add a JSON key, download it.
#   3. Put the file on the server (NOT in this repo -- it is a credential) and
#      point this at it. The JSON itself also works if you would rather not
#      have a file on disk.
#   4. Open the sheet, click Share, and give EDITOR access to the service
#      account's client_email. Skipping this is the one mistake everybody
#      makes; the symptom is a 403 and the Delivery page's "Check access"
#      button says so in words.
#
# GOOGLE_SHEETS_CREDENTIALS=/etc/xscraper/google-sheets.json

# Which timezone the sheet's `date` column is written in. Defaults to
# Asia/Kolkata -- the column is for a human to read, not for a machine.
# SHEET_TZ=Asia/Kolkata


# --- twscrape hygiene ---
# twscrape accumulates PostHog telemetry in-process. It never transmits in
# library mode (only its own CLI calls flush()), but setting this also skips
# the machineid host-fingerprint call at import.
TWS_TELEMETRY=0
DO_NOT_TRACK=1

# NEVER set TWS_PROXY. It silently overrides every per-account proxy set in
# config.toml (twscrape account.py:58-61), collapsing your whole pool onto one
# exit IP — which is precisely the correlation you are paying proxies to avoid.


# --- Escape hatch: GraphQL doc_id override ---
# X rotates the SearchTimeline doc_id every few weeks; the symptom is a sudden
# HTTP 404 on every search. Grab the current one from DevTools (Network tab,
# the SearchTimeline request URL) and set it here to unblock yourself without
# waiting for a twscrape release. Format: "<doc_id>/SearchTimeline".
# X_SEARCH_DOC_ID=

# ------------------------------------------------------------------
# DASHBOARD LOGIN (required to expose `serve` beyond localhost)
#
#   *** EDIT .env, NOT THIS FILE. ***
#
# This file is COMMITTED TO GIT and public. .env is gitignored. Putting a real
# password here publishes it — and because `cp .env.example .env` is the first
# setup step, it also becomes the live password, so the leak is not theoretical.
#
# `serve` REFUSES to bind anything but 127.0.0.1 unless both are set —
# an unauthenticated dashboard can spend rate-limit budget, read every
# collected tweet, and add accounts.
#
# Generate a strong password:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# ------------------------------------------------------------------
DASH_USER=changeme
DASH_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
