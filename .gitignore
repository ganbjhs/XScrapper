# Secrets — never commit.
.env
config.toml

# Session stores. accounts.db holds plaintext cookies (and, on the password
# path, plaintext passwords). profiles/ holds live Chrome sessions.
*.db
*.db-wal
*.db-shm
profiles/

# Outputs
results.*
fb_results.db*
fb_meter.db*
fb_state.json
fb_diag.json
fb_dump*.html
browser-check.jpg
exports/
logs/

# Debug artefacts. Every Facebook dead end leaves a rendered page, a probe
# dump or a screenshot next to the code; on the VPS these accumulate until
# `git status` is unreadable and a real untracked file hides among forty of
# them. Named by shape rather than one-by-one so the next probe is covered too.
fb_*.html
fbli_*.html
fbdoc.html
fb_*.json
fb_*.png
*.pid

# Hand-made safety copies, and the timestamped ones the migrations leave.
*.bak
*.bak-*

# The suite's scratch root (tests/test_all.py: HERE/'.tmp').
tests/.tmp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend. node_modules never; dist IS committed on purpose: the VPS deploys
# by `git pull` and runs no Node at all, so the built app must travel in git.
# Rebuild before committing UI changes: cd frontend && npm run build
frontend/node_modules/
# Vite writes a transpiled copy of vite.config.js next to it during a build and
# normally unlinks it afterwards. A build run over the desktop bridge cannot
# unlink, so they survive — and two got committed. They are build scratch.
frontend/vite.config.js.timestamp-*

# OS
.DS_Store
# FUSE leaves these behind when a mounted file is deleted while still open
# (the desktop bridge cannot unlink, so they accumulate). Two of them were
# committed by accident; they are junk, never source.
.fuse_hidden*

# Account pool
pool.db
pool.db-*

# Local scratch — the bridge cannot delete, so removals are staged here first.
_to_delete/

# Per-machine Claude Code settings and worktrees.
.claude/

# GitHub Actions deploy keypair, generated locally. The private half is pasted
# into the repo secret DEPLOY_SSH_KEY and the public half into the VPS
# authorized_keys; neither ever belongs in git.
.deploy-key/

# Scratch from Claude sessions (patches, tarballs, prompts).
Claude outputs/

# Generated secrets staged for the server (never committed).
_secrets/

# Per-platform recovery files (operator's request, 2026-09-12). These hold the
# whole story of each platform: architecture, every dead end, the log, the
# playbook, the rebuild order. They are NOT in git — which means they exist on
# ONE machine, with no backup, and they are precisely the files whose purpose is
# recovery. Copy them somewhere durable and private (_secrets/, a private repo)
# or the first disk failure takes the recovery plan with it.
PLATFORM_INSTAGRAM.md
PLATFORM_FACEBOOK.md
PLATFORM_X.md
