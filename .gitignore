# Secrets — never commit.
.env
config.toml

# Session stores. accounts.db holds plaintext cookies (and, on the password
# path, plaintext passwords). profiles/ holds live Chrome sessions.
*.db
*.db-wal
*.db-shm
profiles/

# Outputs
results.*
fb_results.db*
fb_meter.db*
fb_state.json
fb_diag.json
fb_dump*.html
browser-check.jpg
exports/
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend. node_modules never; dist IS committed on purpose: the VPS deploys
# by `git pull` and runs no Node at all, so the built app must travel in git.
# Rebuild before committing UI changes: cd frontend && npm run build
frontend/node_modules/

# OS
.DS_Store
# FUSE leaves these behind when a mounted file is deleted while still open
# (the desktop bridge cannot unlink, so they accumulate). Two of them were
# committed by accident; they are junk, never source.
.fuse_hidden*

# Account pool
pool.db
pool.db-*

# Local scratch — the bridge cannot delete, so removals are staged here first.
_to_delete/

# Per-machine Claude Code settings and worktrees.
.claude/
