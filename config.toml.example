# Copy this to config.toml and edit it.
#
#     cp config.toml.example config.toml
#
# Passwords are NOT written here. This file only names the environment variable
# that holds each password; the values themselves live in .env. That way this
# file is safe to copy or back up, and .env is the only thing to guard.

[defaults]
db_accounts  = "accounts.db"      # where the X login session is stored
db_results   = "results.db"       # where collected tweets are stored
profiles_dir = "profiles"         # one browser profile per account

page_size          = 20           # tweets fetched per request (X caps this ~20)
max_pages_per_poll = 5            # most requests one check may spend
min_interval_s     = 5            # fastest we re-check
max_interval_s     = 900          # slowest, when things have gone quiet
overlap_ms         = 60000        # re-read this far back, to catch late posts

# The raw timeline wrapper around each tweet is about 60% of the database size
# and nothing reads it. Leave this off unless you specifically need it.
keep_entry_json    = false


# ---------------------------------------------------------------------------
# Accounts
#
# Use throwaway accounts, never a personal one — automating an account is
# against X's rules and accounts do get locked.
#
# You do not have to edit this by hand. In the dashboard, open "X accounts",
# press "+ Add an account", and it writes a block like this one for you, then
# opens a browser window so you can sign in.
#
# Leave `username` blank. Signing in fills it in with the real name X reports,
# which avoids a mismatch if you type it slightly differently.
# ---------------------------------------------------------------------------
[[accounts]]
label              = "acct_a"
username           = ""
password_env       = "X_PASSWORD_ACCT_A"     # the NAME of a variable in .env
email              = ""
email_password_env = "X_EMAIL_PASSWORD_ACCT_A"

# The browser profile. X remembers it as a known device, which is what keeps
# later sign-ins silent. One per account, and back the folder up.
profile_dir        = "profiles/acct_a"

proxy              = ""                      # e.g. "http://user:pass@host:port"
locale             = "en-US"
timezone           = "Asia/Kolkata"
enabled            = true


# ---------------------------------------------------------------------------
# What to watch
#
# Each block is one thing checked over and over. A block has EITHER a `list_id`
# OR a `query` — never both.
#
# Prefer a list. A list is a set of accounts someone has grouped together on
# x.com, and anyone can watch a public one. X allows 500 list requests every 15
# minutes against 50 for searches, so a list updates about ten times faster and
# never drags in unrelated posts.
#
# `list_id` takes the number from the list's URL, or the whole URL.
# ---------------------------------------------------------------------------
[[streams]]
label   = "politicians"
list_id = "https://x.com/i/lists/1234567890123456789"
enabled = true


# A keyword search. `query` uses X's own search syntax — the same thing you
# would type into the search box on x.com:
#
#   from:someone          only posts by that account
#   -filter:replies       skip replies
#   lang:en               English only
#   min_faves:50          at least 50 likes
#   "exact phrase"        those words together, in that order
#
# Be specific. A search for a common abbreviation collects whatever else uses
# it — a stream here for "RBI" (India's central bank) filled up with baseball,
# because RBI is also "runs batted in".
#
# [[streams]]
# label   = "leaders"
# query   = '(from:narendramodi OR from:AmitShah OR from:PMOIndia) -filter:replies'
# enabled = true


# To stop watching something, set enabled = false. Tweets already collected
# stay in the database — nothing here ever deletes them.


# ---------------------------------------------------------------------------
# Sending tweets to another system
#
# Each block is one place we POST new tweets to, seconds after they are
# collected. Delivery position is remembered in the database, so a receiver
# that goes down catches up by itself when it comes back — nothing is lost and
# there is nothing to restart.
#
# Every delivery is signed with a shared secret, so the receiver can prove the
# request came from you. `secret_env` names a variable in .env; a webhook with
# no secret is refused, because anyone who learned the URL could otherwise post
# fake tweets into your system.
#
# A new endpoint starts from NOW, not from the whole archive.
#
#   python3 main.py webhook --test      send one real tweet, consuming nothing
#   python3 main.py webhook --status    how far each endpoint has got
#
# [[webhooks]]
# label      = "main"
# url        = "https://your-system.example.com/hooks/tweets"
# secret_env = "WEBHOOK_SECRET_MAIN"       # the NAME of a variable in .env
# streams    = []                          # e.g. ["politicians"]; empty = all
# batch_size = 50                          # tweets per POST
# min_likes  = 0                           # skip quieter tweets
# skip_retweets = false
# enabled    = true
#
# Telegram is NOT configured here. Switch it on per list with the gear in the
# dashboard — those settings live in the database so the running watcher picks
# them up without a restart.
