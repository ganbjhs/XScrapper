#!/usr/bin/env bash
# Refuse to commit real secrets in tracked template files.
#
# This has already happened twice: real credentials edited into .env.example
# (committed, public) instead of .env (gitignored). A password in git history
# cannot be unpublished — only rotated. So block it at commit time rather than
# discovering it after a push.
#
# Install:  ln -sf ../../deploy/pre-commit .git/hooks/pre-commit

set -euo pipefail

# An empty value is fine too, handled separately: an empty alternative in the
# group makes BSD grep warn "empty (sub)expression".
PLACEHOLDERS='^(changeme|CHANGE_ME_TO_A_LONG_RANDOM_STRING|admin|password|your-password-here|xxx|todo)$'
fail=0

for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    *.example|*.sample|*.template) ;;
    *) continue ;;
  esac
  while IFS= read -r line; do
    key=${line%%=*}; val=${line#*=}
    case "$key" in
      DASH_PASSWORD|DASH_USER|*_PASSWORD|*_SECRET|*_TOKEN|*_KEY) ;;
      *) continue ;;
    esac
    [ -z "$val" ] && continue
    if ! printf '%s' "$val" | grep -qE "$PLACEHOLDERS"; then
      echo "BLOCKED: $f sets $key to a real-looking value."
      fail=1
    fi
  done < <(git show ":$f" | grep -E '^[A-Z_]+=' || true)
done

if [ "$fail" = 1 ]; then
  cat >&2 <<'MSG'

  Template files are COMMITTED AND PUBLIC. Put real values in .env, which is
  gitignored — not in .env.example.

    keep .env.example as:   DASH_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
    put the real one in:    .env

  A secret committed here is in git history permanently; removing the file
  later does not unpublish it, so it has to be rotated instead.

  To override anyway:  git commit --no-verify
MSG
  exit 1
fi

# ---------------------------------------------------------------------------
# The living-rulebook rule (RULEBOOK.md §0): a commit that changes behavior
# must update RULEBOOK.md in the SAME commit — a rulebook that lags the code
# teaches the next session to rebuild a dead end (mbasic lived on this way).
#
# Opt-out for genuinely behavior-neutral edits:  RULE_OK=1 git commit …
# (or git commit --no-verify, which skips every hook).

# ---------------------------------------------------------------------------
# Protected documents (RULEBOOK.md §8): may be UPDATED, may never be DELETED.
# The rulebook is the law and the blueprint is the rebuild map — a commit that
# removes either one erases the project's memory. No override except --no-verify.

DELETED=$(git diff --cached --name-only --diff-filter=D)
for f in RULEBOOK.md BLUEPRINT.md CHECKPOINT.md; do
  if printf '%s\n' "$DELETED" | grep -qx "$f"; then
    echo "BLOCKED: $f is a protected document — update it, never delete it." >&2
    exit 1
  fi
done

if [ "${RULE_OK:-0}" != "1" ]; then
  CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
  behavior=0
  for f in $CHANGED; do
    # DENY-LIST, not an allow-list. The old version named behavior files one
    # glob at a time and the globs quietly lied: `engine_*.py` does not match
    # `engine.py`, `store_*.py` does not match `store.py`, `ig_*.py` does not
    # match `ig.py`. The X engine and the 164KB X store — the two files most
    # of this rulebook is ABOUT — were exempt from the living-rulebook rule
    # from the day the hook was written, along with classify/sheets/config/
    # signin/pool_link/xlsx_min/migrate_ig_sources (2026-08-25). An allow-list
    # fails silently and in the wrong direction: a file nobody remembered to
    # add is simply never checked, and nothing says so.
    #
    # So: everything is behavior unless it is named here as not.
    #   tests/, tools/       — the suite and standalone diagnostics
    #   fb_*probe/debug      — one-off FB page-structure inspectors
    #   frontend/dist/       — generated by `npm run build`; requiring a rule
    #                          for a rebuild would train people to use RULE_OK
    case "$f" in
      tests/*|tools/*|fb_debug.py|fb_probe.py|fb_data_probe.py) ;;
      frontend/dist/*) ;;
      # The dashboard is behavior the operator SEES, and it was never checked:
      # the modal that rendered underneath the feed thumbnails and the Live
      # Feed filters that reset on every visit both landed with no rule.
      *.py|frontend/src/*)
        behavior=1 ;;
    esac
  done
  if [ "$behavior" = 1 ] && ! printf '%s\n' "$CHANGED" | grep -qx 'RULEBOOK.md'; then
    cat >&2 <<'MSG'
BLOCKED: this commit changes engine/collector/server behavior but does not
touch RULEBOOK.md (the living-rulebook rule, RULEBOOK.md §0).

  Learned a rule?  write it into RULEBOOK.md
  Killed a rule?   correct it there, with the reason
  Truly neutral?   RULE_OK=1 git commit …
MSG
    exit 1
  fi
fi
