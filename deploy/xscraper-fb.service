[Unit]
Description=Facebook Collector (per-page cadence / favorites mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xscraper
Group=xscraper
WorkingDirectory=/opt/xscraper/app
Environment=DO_NOT_TRACK=1
# Mode (pages vs favorites), cadence and the global pause all come from the
# dashboard settings, re-read every cycle — no restart to steer collection.
# --tick is how often the loop wakes to check which pages are due.
ExecStart=/opt/xscraper/app/.venv/bin/python3 collect_fb.py run --loop --tick 300

# A headless browser is heavy and Facebook dislikes churn; back off on restart.
Restart=always
RestartSec=120
StartLimitIntervalSec=900
StartLimitBurst=4

# Chromium's sandbox needs to gain privileges to build itself — same reason
# the web unit is not NoNewPrivileges.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xscraper/app
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
