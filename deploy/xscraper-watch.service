[Unit]
Description=X Collector stream watcher
After=network-online.target
Wants=network-online.target

# StartLimit* belong in [Unit], NOT [Service]. systemd ignores them in
# [Service] and says so in the journal ("Unknown key name ... ignoring"), which
# means the restart rate-limit below was never in effect on any of these units.
# That is not cosmetic: with Restart=always and an inert limiter, a service that
# crashes on start restarts forever instead of hitting start-limit-hit and going
# `failed`. collect_ig.py spent weeks in exactly that loop over a missing
# `import os`, and nothing ever went red. (2026-08-22)
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=xscraper
Group=xscraper
WorkingDirectory=/opt/xscraper/app
Environment=TWS_TELEMETRY=0
Environment=DO_NOT_TRACK=1
# Python block-buffers stdout when it is not a TTY, so print() output sits in an
# 8KB buffer and never reaches journald — the collectors looked completely
# silent under `journalctl -f` while running perfectly. Unbuffered is the only
# way a long-running Python service is observable.
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/xscraper/app/.venv/bin/python3 main.py watch --all

# A long-lived process matters here: twscrape rebuilds its request-signing
# generator on every start, and frequent restarts are themselves a ban signal.
# Back off hard rather than hot-looping on a broken session.
Restart=always
RestartSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xscraper/app
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
